# Copy this file to .env and adjust as needed. Never commit .env.

# SQLAlchemy database URL. Defaults to a SQLite file in the project root.
DATABASE_URL=sqlite:///./clinic.db

# IANA timezone used for "today" and for rejecting past dates/slots.
CLINIC_TIMEZONE=Asia/Amman

# --- AI assistant -------------------------------------------------------------
# Which LLM runs the assistant: "ollama" (local, default) or "anthropic" (Claude API).
LLM_PROVIDER=ollama
# Optional second provider, used only if the first one fails. Leave empty to disable.
LLM_FALLBACK_PROVIDER=

# Local model via Ollama. No API key or internet connection needed.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 0-0.2: low temperature makes small models more reliable at tool calling.
OLLAMA_TEMPERATURE=0.1
# Seconds to wait for a reply (the first request loads the model into memory).
OLLAMA_TIMEOUT=120

# Claude (optional). Only used when LLM_PROVIDER=anthropic or LLM_FALLBACK_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
